package wordmaster

templ Puzzle() {
	<form
		_="on submit
			halt the event
			set $guess to ''
      		for input in <input/> in me
        		append input.value to $guess
          	end"
	>
		<div class="puzzle-grid">
			<ul class="puzzle-rows">
				<li>
					@PuzzleRow(0, false)
				</li>
				<li>
					@PuzzleRow(1, true)
				</li>
				<li>
					@PuzzleRow(2, true)
				</li>
				<li>
					@PuzzleRow(3, true)
				</li>
				<li>
					@PuzzleRow(4, true)
				</li>
				<li>
					@PuzzleRow(5, true)
				</li>
			</ul>
		</div>
		<button class="submit-button" type="submit">Tarkista</button>
	</form>
}
